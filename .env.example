PORT=3000
HOST=0.0.0.0
MONGO_URI=mongodb://localhost:27017/limpa

# --- Demo mode -------------------------------------------------------------
# Set DEMO_MODE=true for a self-contained demo: Firebase auth is mocked
# (no credentials, tokens decoded locally), Stripe is mocked, and demo data
# is seeded on startup. Great for a throwaway deployment you can open on a phone.
DEMO_MODE=false
# Individual overrides (auto-set by DEMO_MODE, but can be forced):
#   AUTH_MODE=mock|emulator|firebase
#   STRIPE_MODE=mock|live
#   SEED_DEMO=true|false

# Firebase Auth emulator — use this for local development (non-demo)
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FIREBASE_PROJECT_ID=demo-limpa

# Production Firebase — fill these in when deploying without the emulator
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PLATFORM_FEE_RATE=0.005
